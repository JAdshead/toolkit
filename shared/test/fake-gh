#!/usr/bin/env bash
# Stand-in for `gh` in board_test.sh. Keeps the project's items in
# $FAKE_GH_STATE (a JSON file) and answers only the calls `board` makes,
# for project acme/7. $FAKE_GH_BOARD picks the board's fields:
#   ready (default)  Backlog, Ready, In progress, In review, Verifying, Ready to merge, Done; Agent field
#   todo             Todo, In progress, Done; Agent field
#   github           GitHub's default new board: Todo, In Progress, Done; Agent field
#   noprogress       Backlog, Ready, In review, Done (no in-progress option); Agent field
#   upperready       Backlog, READY, In progress, Done; Agent field
#   noagent          like ready, without the Agent field
#   malformed        field-list returns text that isn't JSON
set -euo pipefail

state="${FAKE_GH_STATE:?}"

case "${FAKE_GH_BOARD:-ready}" in
  todo) options='{"id":"o_todo","name":"Todo"},{"id":"o_progress","name":"In progress"},{"id":"o_done","name":"Done"}' ;;
  github) options='{"id":"o_todo","name":"Todo"},{"id":"o_progress","name":"In Progress"},{"id":"o_done","name":"Done"}' ;;
  noprogress) options='{"id":"o_backlog","name":"Backlog"},{"id":"o_ready","name":"Ready"},
    {"id":"o_review","name":"In review"},{"id":"o_done","name":"Done"}' ;;
  upperready) options='{"id":"o_backlog","name":"Backlog"},{"id":"o_ready","name":"READY"},
    {"id":"o_progress","name":"In progress"},{"id":"o_done","name":"Done"}' ;;
  *) options='{"id":"o_backlog","name":"Backlog"},{"id":"o_ready","name":"Ready"},
    {"id":"o_progress","name":"In progress"},{"id":"o_review","name":"In review"},
    {"id":"o_verify","name":"Verifying"},{"id":"o_merge","name":"Ready to merge"},
    {"id":"o_done","name":"Done"}' ;;
esac
agent_field='{"id":"F_AGENT","name":"Agent"},'
[ "${FAKE_GH_BOARD:-ready}" = noagent ] && agent_field=""
fields="{\"fields\":[{\"id\":\"F_STATUS\",\"name\":\"Status\",\"options\":[$options]},$agent_field{\"id\":\"F_AREA\",\"name\":\"Area\",\"options\":[]}]}"

# Like the real API, reject an option id the field doesn't have (including "").
option_name() {
  local name
  name="$(echo "$fields" | jq -r --arg id "$1" '.fields[].options[]? | select(.id == $id) | .name')"
  [ -n "$name" ] || { echo "fake-gh: no single-select option with id \"$1\"" >&2; exit 1; }
  echo "$name"
}

project_is_acme_7() {
  [ "$1" = 7 ] && [ "$2" = --owner ] && [ "$3" = acme ] || { echo "fake-gh: unknown project: $*" >&2; exit 1; }
}

case "$1 $2" in
  "repo view") echo "acme/app" ;;
  "project view") project_is_acme_7 "$3" "$4" "$5"; echo '{"id":"PROJ"}' ;;
  "project field-list") project_is_acme_7 "$3" "$4" "$5"
    if [ "${FAKE_GH_BOARD:-}" = malformed ]; then echo "{not json"; else echo "$fields"; fi ;;
  "project item-list") project_is_acme_7 "$3" "$4" "$5"; cat "$state" ;;
  "project item-edit")
    shift 2
    item="" field="" value="" clear=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --id) item="$2"; shift 2 ;;
        --field-id) field="$2"; shift 2 ;;
        --single-select-option-id) value="$(option_name "$2")"; shift 2 ;;
        --text) value="$2"; shift 2 ;;
        --clear) clear=1; shift ;;
        *) shift ;;
      esac
    done
    key=$([ "$field" = F_STATUS ] && echo status || echo agent)
    tmp="$(mktemp)"
    if [ "$clear" = 1 ]; then
      jq --arg i "$item" --arg k "$key" '.items |= map(if .id == $i then del(.[$k]) else . end)' "$state" > "$tmp"
    else
      jq --arg i "$item" --arg k "$key" --arg v "$value" '.items |= map(if .id == $i then .[$k] = $v else . end)' "$state" > "$tmp"
    fi
    mv "$tmp" "$state"
    if [ -n "${FAKE_GH_STEAL:-}" ] && [ "$key" = agent ] && [ "$item" = "${FAKE_GH_STEAL_ITEM:-$item}" ]; then
      jq --arg i "$item" --arg v "$FAKE_GH_STEAL" '.items |= map(if .id == $i then .agent = $v else . end)' "$state" > "$tmp"
      mv "$tmp" "$state"
    fi
    echo '{}'
    ;;
  *) echo "fake-gh: unexpected call: $*" >&2; exit 64 ;;
esac
