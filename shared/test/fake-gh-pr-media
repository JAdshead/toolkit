#!/usr/bin/env bash
# Stand-in for `gh` in pr_media_test.sh. Answers only the calls `pr-media`
# makes, for repo acme/app, from files in $FAKE_GH_DIR:
#   files          the PR's changed paths, one per line
#   body           the PR body (pr edit --body-file rewrites it)
#   pr.json        the GraphQL answer for the sign-off query
#   perm-<login>   that user's permission on the repo (default: read)
#   fail           calls to refuse, one "<command> <subcommand>" per line (e.g. "pr diff")
set -euo pipefail

dir="${FAKE_GH_DIR:?}"

if [ -f "$dir/fail" ] && grep -qxF "$1 $2" "$dir/fail"; then
  echo "fake-gh: HTTP 406: the diff is too large" >&2; exit 1
fi

case "$1 $2" in
  "repo view") echo "acme/app" ;;
  "pr diff") cat "$dir/files" ;;
  "pr view") cat "$dir/body" ;;
  "pr edit")
    while [ $# -gt 0 ]; do
      case "$1" in
        --body-file) cp "$2" "$dir/body"; shift 2 ;;
        *) shift ;;
      esac
    done ;;
  "api graphql") cat "$dir/pr.json" ;;
  api\ repos/acme/app/collaborators/*)
    login="${2#repos/acme/app/collaborators/}"; login="${login%/permission}"
    cat "$dir/perm-$login" 2>/dev/null || echo read ;;
  *) echo "fake-gh: unexpected call: $*" >&2; exit 64 ;;
esac
