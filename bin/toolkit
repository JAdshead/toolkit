#!/usr/bin/env bash
# toolkit: install or update the shared agent skills and rules.
set -euo pipefail

self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  target="$(readlink "$self")"
  case "$target" in
    /*) self="$target" ;;
    *) self="$(dirname "$self")/$target" ;;
  esac
done
TOOLKIT_DIR="$(cd "$(dirname "$self")/.." && pwd -P)"

usage() {
  cat <<USAGE
Usage: toolkit <command>

Commands:
  install   Link skills and rules for Codex and Gemini, install the Claude Code plugins
  init [dir]  Set up a repo (default: current directory) so every agent working in it
            gets the toolkit's rules and Claude Code enables the plugin. Safe to re-run.
  update    Pull the latest toolkit and ui-ux-pro-max, refresh Claude Code plugins, relink
  validate  Check every skill's SKILL.md frontmatter and shared reference copies
  sync      Copy shared/ references into the skills that use them
  path      Print the toolkit checkout location
USAGE
}

update() {
  if git -C "$TOOLKIT_DIR" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
    echo "==> Pulling $TOOLKIT_DIR"
    git -C "$TOOLKIT_DIR" pull --ff-only
  else
    echo "==> $TOOLKIT_DIR has no upstream branch; skipping git pull"
  fi
  if command -v claude >/dev/null; then
    echo "==> Refreshing ui-ux-pro-max for Claude Code"
    claude plugin marketplace update ui-ux-pro-max-skill
    claude plugin update ui-ux-pro-max@ui-ux-pro-max-skill
  fi
  "$TOOLKIT_DIR/install.sh"
}

MARKETPLACE_REPO="JAdshead/toolkit"
START="<!-- toolkit:start -->"
END="<!-- toolkit:end -->"
IMPORT_RE='^[[:space:]]*@(\./)?AGENTS\.md[[:space:]]*$'

die() { echo "toolkit init: $*" >&2; exit 1; }

# The shared rules, one heading level down, between markers.
rules_block() {
  printf '%s\n' "$START"
  printf '%s\n' "<!-- Managed by \`toolkit init\`: edit rules/AGENTS.md in the toolkit, then re-run it. -->"
  sed 's/^#/##/' "$TOOLKIT_DIR/rules/AGENTS.md"
  printf '%s\n' "$END"
}

# Write to OUT what AGENTS.md should become: the existing block replaced, or a
# block appended. A marker counts only on a line of its own (spaces and CR
# allowed). Fails, changing nothing, unless there is exactly one start marker
# followed by one end marker, or neither.
plan_agents_md() {
  local file="$1" out="$2" block rc=0
  block="$(rules_block)"
  if [ ! -e "$file" ]; then
    printf '%s\n' "$block" > "$out"
    return
  fi
  BLOCK="$block" awk -v start="$START" -v end="$END" '
    function trim(s) { sub(/\r$/, "", s); gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
    { line[NR] = $0; k = trim($0)
      if (k == start) { if (!ns++) sl = NR }
      else if (k == end) { if (!ne++) el = NR } }
    END {
      if (ns == 0 && ne == 0) exit 2
      if (ns != 1 || ne != 1 || el < sl) exit 3
      for (i = 1; i < sl; i++) print line[i]
      print ENVIRON["BLOCK"]
      for (i = el + 1; i <= NR; i++) print line[i]
    }
  ' "$file" > "$out" || rc=$?
  case "$rc" in
    0) ;;
    2) { cat "$file"; printf '\n%s\n' "$block"; } > "$out" ;;
    *) die "$file needs exactly one '$START' line followed by one '$END' line; fix the markers and re-run" ;;
  esac
}

# Write to OUT what .claude/settings.json should become, keeping everything
# already there, including a toolkit entry the repo set itself.
plan_settings() {
  local file="$1" out="$2"
  if [ -s "$file" ]; then cp "$file" "$out"; else printf '{}\n' > "$out"; fi
  jq -e 'type == "object"' "$out" >/dev/null 2>&1 || die "$file is not a JSON object; fix it and re-run"
  jq --arg repo "$MARKETPLACE_REPO" '
    .extraKnownMarketplaces = ((.extraKnownMarketplaces // {})
      | if has("toolkit") then . else .toolkit = {source: {source: "github", repo: $repo}} end)
    | .enabledPlugins = ((.enabledPlugins // {})
      | if has("toolkit@toolkit") then . else .["toolkit@toolkit"] = true end)
  ' "$out" > "$out.new"
  if [ -s "$file" ] && jq -e --slurpfile a "$file" '. == $a[0]' "$out.new" >/dev/null; then
    cp "$file" "$out"
  else
    mv "$out.new" "$out"
  fi
}

# Say what the planned settings file does: whether the plugin ends up enabled,
# and where the toolkit marketplace points when the repo set its own.
settings_message() {
  local file="$1" enabled source
  # Values come from the repo, which may be hostile: print them as JSON (-c,
  # not -r), so control characters are escaped instead of reaching the terminal.
  enabled="$(jq -c '.enabledPlugins["toolkit@toolkit"]' "$file")"
  if [ "$enabled" = true ]; then
    printf 'enabled the toolkit plugin in .claude/settings.json'
  else
    printf 'added the toolkit marketplace to .claude/settings.json; the repo sets toolkit@toolkit to %s, so it stays disabled' "$enabled"
  fi
  # Anything but exactly the toolkit's own source is the repo's choice: show it whole.
  source="$(jq -c --arg repo "$MARKETPLACE_REPO" \
    '.extraKnownMarketplaces.toolkit.source | select(. != {source: "github", repo: $repo})' "$file")"
  [ -z "$source" ] || printf ' (its toolkit marketplace is the repo'"'"'s own: %s)' "$source"
}

# Install SRC at DEST if it differs, and say so.
apply() {
  local src="$1" dest="$2" what="$3"
  cmp -s "$src" "$dest" && return 0
  mkdir -p "$(dirname "$dest")"
  cat "$src" > "$dest"
  echo "$what"
}

# Make an agent's own instruction file import AGENTS.md, creating it if missing.
init_import() {
  local file="$1" import="$2" agents
  agents="$(dirname "$file")/AGENTS.md"
  if [ -L "$file" ] && [ ! -e "$file" ]; then
    echo "skipped $(basename "$file"): it is a link to a missing file" >&2
  elif [ ! -e "$file" ]; then
    printf '%s\n' "$import" > "$file"
    echo "created $(basename "$file") importing AGENTS.md"
  elif [ "$file" -ef "$agents" ] || grep -qE "$IMPORT_RE" "$file"; then
    return 0
  else
    printf '\n%s\n' "$import" >> "$file"
    echo "added $import to $(basename "$file")"
  fi
}

# Print the physical path PATH leads to, following symlinks (the last part
# may not exist). Fails if a parent directory is missing or links loop.
resolve() {
  local p="$1" t n=0 d
  while [ -L "$p" ]; do
    n=$((n + 1)); [ "$n" -le 40 ] || return 1
    t="$(readlink "$p")"
    case "$t" in /*) p="$t" ;; *) p="$(dirname "$p")/$t" ;; esac
  done
  d="$(CDPATH='' cd -- "$(dirname "$p")" 2>/dev/null && pwd -P)" || return 1
  printf '%s/%s\n' "$d" "$(basename "$p")"
}

# Refuse anything init would write that is not an ordinary file (or absent)
# inside DIR: a link out of the repo, a directory where a file goes, or a
# file where the .claude directory goes. A cloned repo is untrusted input.
check_targets() {
  local dir="$1" rel real
  for rel in AGENTS.md CLAUDE.md GEMINI.md .claude .claude/settings.json; do
    [ -e "$dir/$rel" ] || [ -L "$dir/$rel" ] || continue
    real="$(resolve "$dir/$rel")" || die "can't resolve $rel; fix it and re-run"
    case "$real" in "$dir"/*) ;; *) die "$rel leads outside the repo (to $real); refusing to write there" ;; esac
    if [ "$rel" = .claude ]; then
      [ -d "$dir/$rel" ] || die ".claude is not a directory; fix it and re-run"
    elif [ -e "$dir/$rel" ] && [ ! -f "$dir/$rel" ]; then
      die "$rel is not a regular file; fix it and re-run"
    fi
  done
}

init_repo() {
  local dir="${1:-.}" work
  [ -d "$dir" ] || die "no such directory: $dir"
  command -v jq >/dev/null || die "needs jq"
  dir="$(CDPATH='' cd -- "$dir" && pwd -P)"
  work="$(mktemp -d)"
  # shellcheck disable=SC2064
  trap "rm -rf '$work'" EXIT

  # Check every target and work out the AGENTS.md and settings changes before
  # writing anything, so these problems leave the repo untouched.
  check_targets "$dir"
  plan_agents_md "$dir/AGENTS.md" "$work/AGENTS.md"
  plan_settings "$dir/.claude/settings.json" "$work/settings.json"

  apply "$work/AGENTS.md" "$dir/AGENTS.md" "wrote the toolkit rules to AGENTS.md"
  init_import "$dir/CLAUDE.md" "@AGENTS.md"
  init_import "$dir/GEMINI.md" "@./AGENTS.md"
  apply "$work/settings.json" "$dir/.claude/settings.json" "$(settings_message "$work/settings.json")"
  echo "Review and commit the changes in $dir."
}

case "${1:-}" in
  init) init_repo "${2:-}" ;;
  install) "$TOOLKIT_DIR/install.sh" ;;
  update) update ;;
  validate) "$TOOLKIT_DIR/bin/validate-skills" && "$TOOLKIT_DIR/bin/sync-shared" --check ;;
  sync) "$TOOLKIT_DIR/bin/sync-shared" ;;
  path) echo "$TOOLKIT_DIR" ;;
  -h|--help|help|"") usage ;;
  *) usage >&2; exit 1 ;;
esac
