#!/usr/bin/env bash
# toolkit: install or update the shared agent skills and rules.
set -euo pipefail

self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  target="$(readlink "$self")"
  case "$target" in
    /*) self="$target" ;;
    *) self="$(dirname "$self")/$target" ;;
  esac
done
TOOLKIT_DIR="$(cd "$(dirname "$self")/.." && pwd -P)"

usage() {
  cat <<USAGE
Usage: toolkit <command>

Commands:
  install   Link skills and rules for Codex and Gemini, install the Claude Code plugins
  init [dir]  Set up a repo (default: current directory) so every agent working in it
            gets the toolkit's rules and Claude Code enables the plugin (a value the
            repo set itself is kept). Safe to re-run.
  update    Pull the latest toolkit and ui-ux-pro-max, refresh Claude Code plugins, relink
  validate  Check every skill's SKILL.md frontmatter and shared reference copies
  sync      Copy shared/ references into the skills that use them
  path      Print the toolkit checkout location
USAGE
}

update() {
  if git -C "$TOOLKIT_DIR" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
    echo "==> Pulling $TOOLKIT_DIR"
    git -C "$TOOLKIT_DIR" pull --ff-only
  else
    echo "==> $TOOLKIT_DIR has no upstream branch; skipping git pull"
  fi
  if command -v claude >/dev/null; then
    echo "==> Refreshing ui-ux-pro-max for Claude Code"
    claude plugin marketplace update ui-ux-pro-max-skill
    claude plugin update ui-ux-pro-max@ui-ux-pro-max-skill
  fi
  "$TOOLKIT_DIR/install.sh"
}

MARKETPLACE_REPO="JAdshead/toolkit"
START="<!-- toolkit:start -->"
END="<!-- toolkit:end -->"
IMPORT_RE='^[[:space:]]*@(\./)?AGENTS\.md[[:space:]]*$'

die() { echo "toolkit init: $*" >&2; exit 1; }

# The shared rules, one heading level down, between markers.
rules_block() {
  printf '%s\n' "$START"
  printf '%s\n' "<!-- Managed by \`toolkit init\`: edit rules/AGENTS.md in the toolkit (https://github.com/$MARKETPLACE_REPO), then re-run it. -->"
  sed 's/^#/##/' "$TOOLKIT_DIR/rules/AGENTS.md"
  printf '%s\n' "$END"
}

# Write to OUT what AGENTS.md should become: the existing block replaced, or a
# block appended. A marker counts only on a line of its own (spaces and CR
# allowed). Fails, changing nothing, unless there is exactly one start marker
# followed by one end marker, or neither.
plan_agents_md() {
  local file="$1" out="$2" block rc=0
  block="$(rules_block)"
  if [ ! -e "$file" ]; then
    printf '%s\n' "$block" > "$out"
    return
  fi
  BLOCK="$block" awk -v start="$START" -v end="$END" '
    function trim(s) { sub(/\r$/, "", s); gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
    { line[NR] = $0; k = trim($0)
      if (k == start) { if (!ns++) sl = NR }
      else if (k == end) { if (!ne++) el = NR } }
    END {
      if (ns == 0 && ne == 0) exit 2
      if (ns != 1 || ne != 1 || el < sl) exit 3
      for (i = 1; i < sl; i++) print line[i]
      print ENVIRON["BLOCK"]
      for (i = el + 1; i <= NR; i++) print line[i]
    }
  ' "$file" > "$out" || rc=$?
  case "$rc" in
    0) ;;
    2) { cat "$file"; printf '\n%s\n' "$block"; } > "$out" ;;
    *) die "$file needs exactly one '$START' line followed by one '$END' line; fix the markers and re-run" ;;
  esac
}

# Write to OUT what .claude/settings.json should become, keeping everything
# already there, including a toolkit entry the repo set itself.
plan_settings() {
  local file="$1" out="$2"
  if [ -s "$file" ]; then cp "$file" "$out"; else printf '{}\n' > "$out"; fi
  jq -se 'length == 1 and (.[0] | type == "object")' "$out" >/dev/null 2>&1 ||
    die "$file is not a single JSON object; fix it and re-run"
  jq -e 'all(.enabledPlugins, .extraKnownMarketplaces; . == null or type == "object")' "$out" >/dev/null ||
    die "$file has enabledPlugins or extraKnownMarketplaces that is not a JSON object; fix it and re-run"
  jq --arg repo "$MARKETPLACE_REPO" '
    .extraKnownMarketplaces = ((.extraKnownMarketplaces // {})
      | if has("toolkit") then . else .toolkit = {source: {source: "github", repo: $repo}} end)
    | .enabledPlugins = ((.enabledPlugins // {})
      | if has("toolkit@toolkit") then . else .["toolkit@toolkit"] = true end)
  ' "$out" > "$out.new"
  if [ -s "$file" ] && jq -e --slurpfile a "$file" '. == $a[0]' "$out.new" >/dev/null; then
    cp "$file" "$out"
  else
    mv "$out.new" "$out"
  fi
}

# Install SRC at DEST if it differs, and say so.
apply() {
  local src="$1" dest="$2" what="$3"
  cmp -s "$src" "$dest" && return 0
  mkdir -p "$(dirname "$dest")"
  cat "$src" > "$dest"
  echo "$what"
}

# Whether an agent's instruction file already reads AGENTS.md: it links to it
# or has an import line.
imports_agents() { [ "$1" -ef "$(dirname "$1")/AGENTS.md" ] || grep -qE "$IMPORT_RE" "$1" 2>/dev/null; }

# Make an agent's own instruction file import AGENTS.md, creating it if missing.
init_import() {
  local file="$1" import="$2"
  if [ ! -e "$file" ]; then
    printf '%s\n' "$import" > "$file"
    echo "created $(basename "$file") importing AGENTS.md"
  elif imports_agents "$file"; then
    return 0
  else
    printf '\n%s\n' "$import" >> "$file"
    echo "added $import to $(basename "$file")"
  fi
}

# Print the headings in FILE outside the toolkit block (not in code fences),
# indented, or a note if it has other text but no headings. Prints nothing if
# the block is all there is. The repo may be hostile, so the text is read as
# UTF-8 (invalid bytes become U+FFFD) and every Unicode control (Cc: C0, DEL,
# C1) and format (Cf, e.g. bidi overrides) character except the newline is
# dropped; other non-ASCII text is kept.
outside_headings() {
  awk -v start="$START" -v end="$END" '
    { k = $0; sub(/\r$/, "", k); gsub(/^[ \t]+|[ \t]+$/, "", k) }
    k == start { inblock = 1; next }
    k == end { inblock = 0; next }
    inblock || k == "" { next }
    k ~ /^(```|~~~)/ { fence = !fence; other = 1; next }
    !fence && k ~ /^#+([ \t]|$)/ { print "  " k; n++; next }
    { other = 1 }
    END { if (!n && other) print "  (text with no headings)" }
  ' "$1" | perl -MEncode -ne 'print encode("UTF-8", decode("UTF-8", $_) =~ s/(?!\n)[\p{Cc}\p{Cf}]//gr)'
}

# Refuse anything init would write that is not an ordinary file (or absent)
# in DIR. A cloned repo is untrusted input, so init follows no links: the one
# allowed is CLAUDE.md or GEMINI.md linking to the repo's own AGENTS.md, which
# init then leaves alone. AGENTS.md itself must be a regular file or absent.
check_targets() {
  local dir="$1" rel
  for rel in AGENTS.md CLAUDE.md GEMINI.md .claude .claude/settings.json; do
    if [ -L "$dir/$rel" ]; then
      case "$rel" in
        CLAUDE.md|GEMINI.md)
          case "$(readlink "$dir/$rel")" in AGENTS.md|./AGENTS.md) continue ;; esac ;;
      esac
      die "$rel is a link; init writes only regular files (CLAUDE.md and GEMINI.md may link to AGENTS.md). Replace it and re-run"
    fi
    [ -e "$dir/$rel" ] || continue
    if [ "$rel" = .claude ]; then
      [ -d "$dir/$rel" ] || die ".claude is not a directory; fix it and re-run"
    elif [ ! -f "$dir/$rel" ]; then
      die "$rel is not a regular file; fix it and re-run"
    fi
  done
}

init_repo() {
  local dir="${1:-.}" work new_to_claude=""
  [ -d "$dir" ] || die "no such directory: $dir"
  command -v jq >/dev/null || die "needs jq"
  command -v perl >/dev/null || die "needs perl"
  dir="$(CDPATH='' cd -P -- "$dir" && pwd -P)"
  work="$(mktemp -d)"
  # shellcheck disable=SC2064
  trap "rm -rf '$work'" EXIT

  # Check every target and work out the AGENTS.md and settings changes before
  # writing anything, so these problems leave the repo untouched.
  check_targets "$dir"
  plan_agents_md "$dir/AGENTS.md" "$work/AGENTS.md"
  plan_settings "$dir/.claude/settings.json" "$work/settings.json"
  imports_agents "$dir/CLAUDE.md" || new_to_claude="$(outside_headings "$work/AGENTS.md")"

  apply "$work/AGENTS.md" "$dir/AGENTS.md" "wrote the toolkit rules to AGENTS.md"
  init_import "$dir/CLAUDE.md" "@AGENTS.md"
  if [ -n "$new_to_claude" ]; then
    echo "warning: CLAUDE.md now imports all of AGENTS.md, not just the toolkit block. Claude Code will read these parts for the first time; review them before committing:" >&2
    printf '%s\n' "$new_to_claude" >&2
  fi
  init_import "$dir/GEMINI.md" "@./AGENTS.md"
  apply "$work/settings.json" "$dir/.claude/settings.json" "updated .claude/settings.json"
  # The repo may have set these itself, and may be hostile: print them as JSON
  # (-c), so control characters such as ESC are escaped, not sent to the terminal.
  echo "toolkit plugin in .claude/settings.json: $(jq -c '{
    enabled: .enabledPlugins["toolkit@toolkit"],
    marketplace: (.extraKnownMarketplaces.toolkit | if type == "object" then .source else . end)
  }' "$dir/.claude/settings.json")"
  # A toolkit marketplace the repo pointed elsewhere was kept, and the plugin
  # init enables comes from it.
  jq -e --arg repo "$MARKETPLACE_REPO" \
    '(.extraKnownMarketplaces.toolkit | objects | .source | objects | .source == "github" and .repo == $repo) // false' \
    "$dir/.claude/settings.json" >/dev/null ||
    echo "warning: the toolkit marketplace in .claude/settings.json is not github $MARKETPLACE_REPO (shown above); check you trust it" >&2
  echo "Review and commit the changes in $dir."
}

case "${1:-}" in
  init) init_repo "${2:-}" ;;
  install) "$TOOLKIT_DIR/install.sh" ;;
  update) update ;;
  validate) "$TOOLKIT_DIR/bin/validate-skills" && "$TOOLKIT_DIR/bin/sync-shared" --check ;;
  sync) "$TOOLKIT_DIR/bin/sync-shared" ;;
  path) echo "$TOOLKIT_DIR" ;;
  -h|--help|help|"") usage ;;
  *) usage >&2; exit 1 ;;
esac
