#!/usr/bin/env bash
# Copy each shared/<file> into skills/<name>/references/<file> or
# skills/<name>/scripts/<file> for every skill whose SKILL.md mentions that
# path. Skills are linked one folder at a time, so each needs its own copy.
# A copy whose SKILL.md no longer mentions it is stale and is removed.
# With --check, change nothing and fail if any copy is missing, differs
# from shared/ (content or executable bit) or is stale.
# Fails when shared/ holds no files, since then nothing was checked.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
case "${1:-}" in
  "") check=0 ;;
  --check) check=1 ;;
  *) echo "usage: $(basename "$0") [--check]" >&2; exit 2 ;;
esac
status=0
count=0

for src in "$root"/shared/*; do
  [ -f "$src" ] || continue
  count=$((count + 1))
  file="$(basename "$src")"
  used=0
  for skill in "$root"/skills/*/SKILL.md; do
    for sub in references scripts; do
      grep -qF "$sub/$file" "$skill" || continue
      used=1
      dir="$(dirname "$skill")"
      dest="$dir/$sub/$file"
      rel="$(basename "$dir")/$sub/$file"
      if cmp -s "$src" "$dest" && { [ -x "$src" ] && [ -x "$dest" ] || { [ ! -x "$src" ] && [ ! -x "$dest" ]; }; }; then
        echo "ok   $rel"
      elif [ "$check" -eq 1 ]; then
        echo "FAIL $rel is missing or differs from shared/$file (run: bin/sync-shared)"
        status=1
      else
        mkdir -p "$dir/$sub"
        cp -p "$src" "$dest"
        echo "sync $rel"
      fi
    done
  done
  [ "$used" -eq 1 ] || echo "note shared/$file is not used by any skill"
done

if [ "$count" -eq 0 ]; then
  echo "sync-shared: nothing to sync: $root/shared holds no files" >&2
  exit 1
fi

# A copy of a shared file in a skill whose SKILL.md no longer mentions it.
for skill in "$root"/skills/*/SKILL.md; do
  dir="$(dirname "$skill")"
  for sub in references scripts; do
    for dest in "$dir/$sub"/*; do
      [ -f "$dest" ] || continue
      file="$(basename "$dest")"
      [ -f "$root/shared/$file" ] || continue
      grep -qF "$sub/$file" "$skill" && continue
      rel="$(basename "$dir")/$sub/$file"
      if [ "$check" -eq 1 ]; then
        echo "FAIL $rel is stale: SKILL.md no longer mentions it (run: bin/sync-shared)"
        status=1
      else
        rm "$dest"
        echo "remove $rel"
      fi
    done
  done
done

exit "$status"
