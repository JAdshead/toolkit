#!/usr/bin/env python3
"""Summarize a week of Claude Code and Codex usage from local session data.

Reads Claude Code transcripts (<claude-dir>/projects/*/*.jsonl) and Codex threads
(<codex-dir>/state_*.sqlite), read-only, and prints a compact digest with totals.
Per Claude Code session: project, branch, entry point, models, prompts, slash
commands, skills, tool counts, tool errors, denials, interrupts and subagent runs.
Per Codex thread (from the threads table only): project (cwd), title, model,
tokens used and the first user message.

Usage: usage-digest [--since YYYY-MM-DD] [--until YYYY-MM-DD] [--format md|json]
                    [--claude-dir DIR] [--codex-dir DIR] [--out FILE]

The digest quotes prompts from owner-only transcripts, so --out writes FILE as
0600 in a folder of your own made 0700 (created if needed), and refuses any other
folder or a symlink at FILE. Without --out it prints.

The window is [since, until) in local time. Default: the 7 days before today.
"""
import argparse
import collections
import datetime as dt
import errno
import glob
import json
import os
import re
import sqlite3
import sys

MAX_PROMPTS = 8
MAX_PROMPT_CHARS = 300
COMPACTION_PREFIX = "This session is being continued from a previous conversation"
DENIAL_MARKERS = ("doesn't want to proceed", "was rejected", "permission denied by user", "user denied",
                  "denied by the claude code auto mode classifier", "denied by a built-in claude code safety check")
# Claude Code's own elements (<system-reminder>, <bash-stdout>, <ide_opened_file>...) all have a - or _ in
# their name and HTML's never do, so a complete element named that way is the harness, not typed or pasted
# text. <pasted_content> is the exception: it holds what the user pasted.
HARNESS_ELEMENT = re.compile(r"<(?!pasted_content[\s>])([A-Za-z][\w.-]*[-_][\w.-]*)(?=[\s>])[^>]*>.*?</\1>", re.S)


def parse_args():
    p = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    today = dt.date.today()
    p.add_argument("--since", default=(today - dt.timedelta(days=7)).isoformat())
    p.add_argument("--until", default=today.isoformat())
    p.add_argument("--format", choices=("md", "json"), default="md")
    p.add_argument("--claude-dir", default=os.path.expanduser("~/.claude"))
    p.add_argument("--codex-dir", default=os.path.expanduser("~/.codex"))
    p.add_argument("--out", help="write to FILE (0600, in a folder of your own) instead of stdout")
    return p.parse_args()


def local_midnight(day):
    return dt.datetime.combine(dt.date.fromisoformat(day), dt.time()).astimezone()


def parse_ts(value):
    """An aware datetime; a timestamp without a timezone is local time."""
    try:
        ts = dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
    except (AttributeError, ValueError):
        return None
    return ts if ts.tzinfo else ts.astimezone()


def entries(path, since, until):
    """(entry, timestamp) for each transcript line timestamped in [since, until)."""
    with open(path, encoding="utf-8", errors="replace") as f:
        for raw in f:
            try:
                e = json.loads(raw)
            except ValueError:
                continue
            ts = parse_ts(e.get("timestamp"))
            if ts and since <= ts < until:
                yield e, ts


def text_blocks(content):
    """The text of message content, which is a string or a list of blocks."""
    if not isinstance(content, list):
        return [content] if isinstance(content, str) else []
    return [b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text"]


def text_of(content):
    return "\n".join(text_blocks(content))


def human_text(content):
    """The typed part of a user message, without harness elements like <system-reminder>...</system-reminder>."""
    return "\n".join(t for t in (HARNESS_ELEMENT.sub("", b).strip() for b in text_blocks(content)) if t)


def clip(text):
    text = " ".join(text.split())
    return text if len(text) <= MAX_PROMPT_CHARS else text[: MAX_PROMPT_CHARS - 1] + "…"


def summarize_claude_session(path, since, until):
    s = {"id": None, "cwd": None, "branch": None, "entrypoint": None, "start": None, "end": None,
         "prompts": [], "prompt_count": 0, "slash_commands": [], "skills": [], "tools": collections.Counter(),
         "tool_errors": 0, "denials": 0, "interrupts": 0, "models": [], "subagents": 0}
    for e, ts in entries(path, since, until):
        kind = e.get("type")
        if kind not in ("user", "assistant"):
            continue
        for key, field in (("id", "sessionId"), ("cwd", "cwd"), ("branch", "gitBranch"), ("entrypoint", "entrypoint")):
            s[key] = s[key] or e.get(field)
        s["start"], s["end"] = min(s["start"] or ts, ts), max(s["end"] or ts, ts)
        msg = e.get("message") or {}
        content = msg.get("content")
        blocks = [b for b in content if isinstance(b, dict)] if isinstance(content, list) else []
        if kind == "assistant":
            model = msg.get("model")
            if model and model not in s["models"] and not model.startswith("<"):
                s["models"].append(model)
            for b in blocks:
                if b.get("type") == "tool_use":
                    s["tools"][b.get("name", "?")] += 1
                    skill = (b.get("input") or {}).get("skill") if b.get("name") == "Skill" else None
                    if skill and skill not in s["skills"]:
                        s["skills"].append(skill)
            continue
        results = [b for b in blocks if b.get("type") == "tool_result"]
        for b in results:
            if b.get("is_error"):
                s["tool_errors"] += 1
                s["denials"] += any(m in text_of(b.get("content")).lower() for m in DENIAL_MARKERS)
        if results or e.get("isMeta") or e.get("isSidechain"):
            continue
        text = text_of(content).strip()
        if text.startswith("[Request interrupted"):
            s["interrupts"] += 1
        elif "<command-name>" in text:
            cmd = text.split("<command-name>", 1)[1].split("</command-name>", 1)[0].strip()
            if cmd and cmd not in s["slash_commands"]:
                s["slash_commands"].append(cmd)
        else:
            prompt = human_text(content)
            if prompt and not prompt.startswith(COMPACTION_PREFIX):
                s["prompt_count"] += 1
                if len(s["prompts"]) < MAX_PROMPTS:
                    s["prompts"].append(clip(prompt))
    if s["start"] is None:
        return None
    stem = os.path.splitext(path)[0]
    s["id"] = s["id"] or os.path.basename(stem)
    runs = glob.glob(os.path.join(stem, "subagents", "*.jsonl"))
    s["subagents"] = sum(next(entries(p, since, until), None) is not None for p in runs)  # runs with an entry in the window
    s["tools"] = dict(s["tools"].most_common())
    s["start"], s["end"] = s["start"].isoformat(), s["end"].isoformat()
    return s


def claude_usage(claude_dir, since, until):
    sessions = []
    for path in sorted(glob.glob(os.path.join(claude_dir, "projects", "*", "*.jsonl"))):
        if os.path.getmtime(path) < since.timestamp():
            continue
        s = summarize_claude_session(path, since, until)
        if s:
            sessions.append(s)
    sessions.sort(key=lambda s: s["start"])
    by_project, tools, skills, slash, mcp = (collections.Counter() for _ in range(5))
    for s in sessions:
        by_project[s["cwd"] or "?"] += 1
        tools.update(s["tools"])
        skills.update(s["skills"])
        slash.update(s["slash_commands"])
        for name, n in s["tools"].items():
            if name.startswith("mcp__"):
                mcp[name.split("__")[1]] += n
    totals = {"sessions": len(sessions), "prompts": sum(s["prompt_count"] for s in sessions),
              **{k: sum(s[k] for s in sessions) for k in ("tool_errors", "denials", "interrupts", "subagents")},
              "by_project": dict(by_project.most_common()), "tools": dict(tools.most_common()),
              "skills": dict(skills.most_common()), "slash_commands": dict(slash.most_common()),
              "mcp_servers": dict(mcp.most_common())}
    return {"sessions": sessions, "totals": totals}


def codex_usage(codex_dir, since, until):
    threads = []
    for db_path in sorted(glob.glob(os.path.join(codex_dir, "state_*.sqlite"))):
        try:
            db = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
            db.row_factory = sqlite3.Row
            cols = {r[1] for r in db.execute("pragma table_info(threads)")}
            wanted = [c for c in ("id", "created_at", "updated_at", "cwd", "title", "model", "tokens_used",
                                  "first_user_message") if c in cols]
            rows = db.execute(f"select {', '.join(wanted)} from threads where updated_at >= ? and created_at < ?",
                              (int(since.timestamp()), int(until.timestamp()))).fetchall()
            db.close()
        except sqlite3.Error as err:
            print(f"warning: could not read {db_path}: {err}", file=sys.stderr)
            continue
        for r in rows:
            t = dict(r)
            t["first_user_message"] = clip(t.get("first_user_message") or "")
            for key in ("created_at", "updated_at"):
                if t.get(key):
                    t[key] = dt.datetime.fromtimestamp(t[key]).astimezone().isoformat()
            threads.append(t)
    by_project = collections.Counter(t.get("cwd") or "?" for t in threads)
    return {"threads": threads, "totals": {"threads": len(threads), "by_project": dict(by_project.most_common()),
                                           "tokens_used": sum(t.get("tokens_used") or 0 for t in threads)}}


def counts(d, limit=15):
    return ", ".join(f"{k} ({v})" for k, v in list(d.items())[:limit]) or "none"


def markdown(data):
    out = [f"# Agent usage digest: {data['since']} to {data['until']} (until is exclusive)", ""]
    c = data["claude_code"]
    t = c["totals"]
    out += ["## Claude Code", "",
            f"- Sessions: {t['sessions']}, human prompts: {t['prompts']}, subagent runs: {t['subagents']}",
            f"- Tool errors: {t['tool_errors']}, permission denials: {t['denials']}, interrupts: {t['interrupts']}",
            f"- By project: {counts(t['by_project'])}",
            f"- Skills invoked: {counts(t['skills'])}",
            f"- Slash commands: {counts(t['slash_commands'])}",
            f"- MCP servers used: {counts(t['mcp_servers'])}",
            f"- Top tools: {counts(t['tools'])}", ""]
    for s in c["sessions"]:
        out += [f"### {s['start'][:16]} · {s['cwd']} · {s['branch'] or '-'} · {s['entrypoint'] or '-'}",
                f"prompts {s['prompt_count']}, errors {s['tool_errors']}, denials {s['denials']}, "
                f"interrupts {s['interrupts']}, subagents {s['subagents']}, models {', '.join(s['models']) or '-'}"]
        if s["skills"] or s["slash_commands"]:
            out.append(f"skills: {', '.join(s['skills']) or '-'}; commands: {', '.join(s['slash_commands']) or '-'}")
        out += [f"tools: {counts(s['tools'], 8)}", *(f"> {p}" for p in s["prompts"]), ""]
    x = data["codex"]
    out += ["## Codex", "", f"- Threads: {x['totals']['threads']}, tokens: {x['totals']['tokens_used']}",
            f"- By project: {counts(x['totals']['by_project'])}", ""]
    for th in x["threads"]:
        out.append(f"- {str(th.get('created_at', ''))[:16]} · {th.get('cwd')} · {th.get('title')} · "
                   f"{th.get('model')}: {th.get('first_user_message')}")
    return "\n".join(out) + "\n"


def write_private(path, text):
    folder = os.path.dirname(os.path.abspath(path))
    os.makedirs(folder, mode=0o700, exist_ok=True)
    if os.stat(folder).st_uid != os.getuid():
        sys.exit(f"error: {folder} is not yours, so the digest can't be kept private; use a folder of your own")
    os.chmod(folder, 0o700)
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    except OSError as err:
        if err.errno == errno.ELOOP:
            sys.exit(f"error: {path} is a symlink; the digest is only written to a plain file of yours")
        sys.exit(f"error: can't write {path} ({err.strerror})")
    os.fchmod(fd, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text)


def main():
    args = parse_args()
    since, until = local_midnight(args.since), local_midnight(args.until)
    data = {"since": args.since, "until": args.until,
            "claude_code": claude_usage(args.claude_dir, since, until),
            "codex": codex_usage(args.codex_dir, since, until)}
    text = json.dumps(data, indent=2, default=str) + "\n" if args.format == "json" else markdown(data)
    if args.out:
        write_private(args.out, text)
    else:
        sys.stdout.write(text)


if __name__ == "__main__":
    main()
