#!/usr/bin/env bash
# Stand-in for `gh` in board_test.sh. Keeps the project's items in
# $FAKE_GH_STATE (a JSON file) and answers only the calls `board` makes.
set -euo pipefail

state="${FAKE_GH_STATE:?}"

fields='{"fields":[
  {"id":"F_STATUS","name":"Status","options":[
    {"id":"o_backlog","name":"Backlog"},{"id":"o_ready","name":"Ready"},
    {"id":"o_progress","name":"In progress"},{"id":"o_review","name":"In review"},
    {"id":"o_verify","name":"Verifying"},{"id":"o_merge","name":"Ready to merge"},
    {"id":"o_done","name":"Done"}]},
  {"id":"F_AGENT","name":"Agent"},
  {"id":"F_AREA","name":"Area","options":[]}]}'

option_name() {
  echo "$fields" | jq -r --arg id "$1" '.fields[].options[]? | select(.id == $id) | .name'
}

case "$1 $2" in
  "repo view") echo "acme/app" ;;
  "project view") echo '{"id":"PROJ"}' ;;
  "project field-list") echo "$fields" ;;
  "project item-list") cat "$state" ;;
  "project item-edit")
    shift 2
    item="" field="" value="" clear=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --id) item="$2"; shift 2 ;;
        --field-id) field="$2"; shift 2 ;;
        --single-select-option-id) value="$(option_name "$2")"; shift 2 ;;
        --text) value="$2"; shift 2 ;;
        --clear) clear=1; shift ;;
        *) shift ;;
      esac
    done
    key=$([ "$field" = F_STATUS ] && echo status || echo agent)
    tmp="$(mktemp)"
    if [ "$clear" = 1 ]; then
      jq --arg i "$item" --arg k "$key" '.items |= map(if .id == $i then del(.[$k]) else . end)' "$state" > "$tmp"
    else
      jq --arg i "$item" --arg k "$key" --arg v "$value" '.items |= map(if .id == $i then .[$k] = $v else . end)' "$state" > "$tmp"
    fi
    mv "$tmp" "$state"
    if [ -n "${FAKE_GH_STEAL:-}" ] && [ "$key" = agent ] && [ "$item" = "${FAKE_GH_STEAL_ITEM:-$item}" ]; then
      jq --arg i "$item" --arg v "$FAKE_GH_STEAL" '.items |= map(if .id == $i then .agent = $v else . end)' "$state" > "$tmp"
      mv "$tmp" "$state"
    fi
    echo '{}'
    ;;
  *) echo "fake-gh: unexpected call: $*" >&2; exit 64 ;;
esac
