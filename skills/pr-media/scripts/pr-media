#!/usr/bin/env bash
# Screenshots and video for a pull request, kept on the hidden ref
# refs/pr-media/<pr> of origin (not a branch or tag, so clones and fetches
# skip it). Run from a checkout of the PR's repo. See ../SKILL.md.
#
#   pr-media ui <pr>                 0: the PR changes UI (prints those files), 1: it doesn't
#   pr-media attach <pr> <file>...   publish the files and show them in the PR body's Screenshots
#                                    section, with a "Head: <sha>" line naming the PR's head
#   pr-media capture <spec.json>     screenshot the running app with Playwright and print each
#                                    file's path; run it where node_modules has playwright
#
# Exit codes: 2 on any error (gh, git or the capture failed, bad arguments),
# so a caller never reads an error as "not a UI PR".
set -euo pipefail

die() { echo "pr-media: $*" >&2; exit 2; }
usage() { sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

ui_files='(^|/)(views|components|templates|layouts|pages|styles|locales|i18n)/|\.(css|scss|sass|less|html|erb|haml|slim|jsx|tsx|vue|svelte|astro|hbs|liquid|twig|njk|svg)$'
start_marker='<!-- pr-media:start -->'
end_marker='<!-- pr-media:end -->'

cmd_ui() {
  local files matched
  files="$(gh api --paginate "repos/{owner}/{repo}/pulls/$1/files" --jq '.[].filename')" || die "could not list the files of PR $1"
  matched="$(grep -E "$ui_files" <<<"$files" || true)"
  [ -n "$matched" ] || return 1
  echo "$matched"
}

cmd_attach() {
  local pr="$1" repo head body parent="" commit index name blob tree f section
  shift
  [ $# -gt 0 ] || usage
  for f in "$@"; do
    [ -f "$f" ] || die "no such file: $f"
    [[ "$(basename "$f")" =~ ^[A-Za-z0-9._-]+$ ]] || die "rename $f to letters, digits, '.', '_' and '-' only"
  done
  [ -z "$(for f in "$@"; do basename "$f"; done | sort | uniq -d)" ] || die "two files share a name"

  repo="$(gh repo view --json nameWithOwner --jq .nameWithOwner)" || die "could not name the repo"
  [ -n "$repo" ] || die "could not name the repo"
  head="$(gh pr view "$pr" --json headRefOid --jq .headRefOid)" || die "could not read the head of PR $pr"
  body="$(gh pr view "$pr" --json body --jq .body)" || die "could not read the body of PR $pr"
  body="$(tr -d '\r' <<<"$body")"
  [ "$(grep -cxF "$start_marker" <<<"$body")" = "$(grep -cxF "$end_marker" <<<"$body")" ] &&
    [ "$(grep -cxF "$start_marker" <<<"$body")" -le 1 ] || die "PR $pr's body has unmatched pr-media markers; fix them by hand"

  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  index="$tmp/index"
  parent="$(git ls-remote origin "refs/pr-media/$pr")" || die "could not reach origin"
  parent="${parent%%[[:space:]]*}"
  if [ -n "$parent" ]; then
    git fetch -q origin "refs/pr-media/$pr" || die "could not fetch refs/pr-media/$pr"
  fi
  for f in "$@"; do
    name="$(basename "$f")"
    blob="$(git hash-object -w "$f")" || die "could not store $f"
    GIT_INDEX_FILE="$index" git update-index --add --cacheinfo "100644,$blob,$name" || die "could not stage $f"
  done
  tree="$(GIT_INDEX_FILE="$index" git write-tree)" || die "could not write the tree"
  if [ -n "$parent" ]; then
    commit="$(git commit-tree "$tree" -p "$parent" -m "Media for PR $pr")" || die "could not commit the media"
  else
    commit="$(git commit-tree "$tree" -m "Media for PR $pr")" || die "could not commit the media"
  fi
  [ -n "$commit" ] || die "could not commit the media"
  git push -q origin "$commit:refs/pr-media/$pr" || die "could not push refs/pr-media/$pr"

  section="$start_marker"$'\n'"## Screenshots"$'\n\n'"Head: $head"$'\n'
  for f in "$@"; do
    name="$(basename "$f")"
    case "$name" in
      *.mp4|*.webm|*.mov) section+=$'\n'"[$name](https://github.com/$repo/raw/$commit/$name)"$'\n' ;;
      *) section+=$'\n'"![$name](https://github.com/$repo/raw/$commit/$name)"$'\n' ;;
    esac
  done
  section+="$end_marker"
  if grep -qxF "$start_marker" <<<"$body"; then
    {
      sed "/^$start_marker\$/,\$d" <<<"$body"
      echo "$section"
      sed "1,/^$end_marker\$/d" <<<"$body"
    } > "$tmp/body"
  else
    printf '%s\n\n%s\n' "$body" "$section" > "$tmp/body"
  fi
  gh pr edit "$pr" --body-file "$tmp/body" >/dev/null || die "could not update the body of PR $pr"
  echo "attached to PR $pr at $commit"
}

cmd_capture() {
  [ -f "$1" ] || die "no such spec: $1"
  command -v node >/dev/null || die "capture needs node"
  node - "$1" <<'JS' || exit 2
const fs = require('fs');
const path = require('path');
const { execSync } = require('child_process');
const { createRequire } = require('module');

const die = (msg) => { console.error(`pr-media: ${msg}`); process.exit(2); };

function playwright() {
  const roots = [path.join(process.cwd(), 'noop.js')];
  try { roots.push(path.join(execSync('npm root -g', { encoding: 'utf8' }).trim(), 'noop.js')); } catch {}
  for (const root of roots) {
    for (const name of ['playwright', '@playwright/test', 'playwright-core']) {
      try { return createRequire(root)(name); } catch {}
    }
  }
  die('capture needs Playwright: run it from a project whose node_modules has playwright');
}

let spec;
try { spec = JSON.parse(fs.readFileSync(process.argv[2], 'utf8')); } catch (e) { die(`cannot read ${process.argv[2]}: ${e.message}`); }
const { baseUrl, out, signIn } = spec;
const widths = spec.widths || [1280, 375];
const shots = spec.shots || [];
if (!baseUrl || !out) die('the spec needs baseUrl and out');
if (!Array.isArray(shots) || shots.length === 0) die('the spec has no shots');
for (const shot of shots) {
  if (!/^[A-Za-z0-9._-]+$/.test(shot.name || '')) die(`name each shot with letters, digits, '.', '_' and '-' only: ${JSON.stringify(shot.name)}`);
  if (!shot.path) die(`shot ${shot.name} has no path`);
}
fs.mkdirSync(out, { recursive: true });

async function unpin(page) {
  await page.evaluate(async () => {
    await new Promise((done) => requestAnimationFrame(() => requestAnimationFrame(done)));
    for (const el of document.querySelectorAll('*')) {
      const position = getComputedStyle(el).position;
      if (position === 'sticky') el.style.setProperty('position', 'static', 'important');
      if (position === 'fixed') el.style.setProperty('visibility', 'hidden', 'important');
    }
  });
}

(async () => {
  const { chromium } = playwright();
  const browser = await chromium.launch();
  try {
    let storageState;
    if (signIn) {
      const context = await browser.newContext();
      const page = await context.newPage();
      page.setDefaultTimeout(15000);
      await page.goto(new URL(signIn.path, baseUrl).href);
      for (const selector of signIn.clickFirst || []) await page.click(selector);
      for (const [selector, value] of Object.entries(signIn.fields || {})) await page.fill(selector, String(value));
      await page.click(signIn.submit || '[type=submit]');
      const signInPath = new URL(signIn.path, baseUrl).pathname;
      try {
        await page.waitForURL((url) => url.pathname !== signInPath);
      } catch {
        die(`sign-in never left ${signIn.path}: check the credentials and the submit selector`);
      }
      await page.waitForLoadState('load');
      storageState = await context.storageState();
      await context.close();
    }
    for (const width of widths) {
      const context = await browser.newContext({ viewport: { width, height: width < 768 ? 812 : 900 }, storageState });
      const page = await context.newPage();
      page.setDefaultTimeout(15000);
      for (const shot of shots) {
        await page.goto(new URL(shot.path, baseUrl).href, { waitUntil: 'load' });
        if (shot.waitFor) await page.locator(shot.waitFor).first().waitFor();
        if (shot.openDetails !== false) await page.evaluate(() => document.querySelectorAll('details').forEach((d) => { d.open = true; }));
        const file = path.join(out, `${shot.name}-${width}.png`);
        if (shot.crop) {
          const target = page.locator(`${shot.crop} >> visible=true`).first();
          try {
            await target.waitFor({ timeout: 5000 });
          } catch {
            die(`shot ${shot.name}: nothing visible matches ${shot.crop} on ${shot.path}`);
          }
          await target.scrollIntoViewIfNeeded();
          if (!shot.keepSticky) {
            await unpin(page);
            if (!(await target.isVisible())) die(`shot ${shot.name}: ${shot.crop} sits inside a sticky or fixed element that capture hides; set "keepSticky": true`);
          }
          await target.screenshot({ path: file, animations: 'disabled' });
        }
        else {
          if (!shot.keepSticky) await unpin(page);
          await page.screenshot({ path: file, fullPage: shot.fullPage !== false, animations: 'disabled' });
        }
        console.log(file);
      }
      await context.close();
    }
  } catch (e) {
    die(`capture failed: ${e.message.split('\n')[0]}`);
  } finally {
    await browser.close();
  }
})();
JS
}

case "${1:-}" in
  capture) [ $# -eq 2 ] || usage; cmd_capture "$2" ;;
  ui) [ $# -eq 2 ] || usage; cmd_ui "$2" ;;
  attach) [ $# -ge 3 ] || usage; shift; cmd_attach "$@" ;;
  *) usage ;;
esac
