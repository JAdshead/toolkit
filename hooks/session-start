#!/usr/bin/env bash
# Claude Code SessionStart hook: add the toolkit's working rules to the session
# unless they already reach it, through the project's toolkit block (toolkit
# init) or a global CLAUDE.md that is the rules file (install.sh). Its output
# becomes session context.
set -uo pipefail

root="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
rules="$root/rules/AGENTS.md"
project="${CLAUDE_PROJECT_DIR:-$PWD}"

[ -f "$rules" ] || exit 0

# A toolkit init block: the start marker on a line of its own. One in AGENTS.md
# counts only if CLAUDE.md imports AGENTS.md or links to it, since that is how
# it reaches Claude Code.
has_block() { [ -f "$1" ] && grep -qE '^[[:space:]]*<!-- toolkit:start -->[[:space:]]*$' "$1"; }
claude="$project/CLAUDE.md"
has_block "$claude" && exit 0
if has_block "$project/AGENTS.md" && [ -f "$claude" ] &&
  { [ "$claude" -ef "$project/AGENTS.md" ] || grep -qE '^[[:space:]]*@(\./)?AGENTS\.md[[:space:]]*$' "$claude"; }; then
  exit 0
fi

# install.sh links ~/.claude/CLAUDE.md to some checkout's rules/AGENTS.md,
# which may be a different version from this plugin's copy. A plain copy of
# this plugin's rules counts too.
global="$HOME/.claude/CLAUDE.md"
cmp -s "$global" "$rules" && exit 0
case "$(readlink "$global" 2>/dev/null)" in */rules/AGENTS.md) exit 0 ;; esac

echo "The toolkit plugin's working rules apply in this session:"
echo
cat "$rules"
exit 0
